# Server port (default: 3000)
PORT=3000

# JWT signing secret (auto-generated if not set, changes on restart)
JWT_SECRET=your-secret-here

# Pre-create a user on startup (optional, useful for Docker)
AUTH_USERNAME=admin
AUTH_PASSWORD=your-password

# Where project folders live (default: ~/projects)
WORKSPACES_ROOT=/home/user/projects

# Path to claude executable (default: 'claude' on PATH)
CLAUDE_CLI_PATH=claude

# Where to store user credentials (default: .credentials.json next to server.js)
CREDENTIALS_FILE=/data/credentials.json
