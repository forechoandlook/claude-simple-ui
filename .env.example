# Server port (default: 3000)
PORT=3000

# Pre-create a user on startup (optional, useful for Docker)
AUTH_USERNAME=admin
AUTH_PASSWORD=your-password

# Where project folders live (default: ~/projects)
WORKSPACES_ROOT=/home/user/projects

# Enabled agents (default: claude,codex,grok)
AGENTS=claude,codex,grok

# Path to CLI executables (defaults: name on PATH)
CLAUDE_CLI_PATH=claude
CODEX_CLI_PATH=codex
GROK_CLI_PATH=grok

# Agent homes / config dirs
CLAUDE_CONFIG_DIRS=~/.claude-personal,~/.claude
CODEX_HOME=~/.codex
GROK_HOME=~/.grok

# Where to store user credentials (default: .credentials.json next to server.js)
CREDENTIALS_FILE=/data/credentials.json

# Meta Agent (built-in OpenAI-compatible assistant) stores config in .ai_config.json
# Configure API URL / Key / VLM via WebUI: top bar → ✦ Agent → ⚙
# Chat sessions & VLM threads (default: <project>/.ai/)
# AI_DATA_DIR=/data/claude-simple-ai
